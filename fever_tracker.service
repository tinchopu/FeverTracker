[Unit]
Description=Streamlit Fever Tracker Application
After=network.target

[Service]
User=fevertracker_user
Group=fevertracker_user
WorkingDirectory=/opt/fevertracker
ExecStart=/usr/bin/uv run streamlit run main.py --server.port 8501 --server.headless true
Restart=always
RestartSec=10
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=fever_tracker

[Install]
WantedBy=multi-user.target
