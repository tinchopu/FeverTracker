[Unit]
Description=Streamlit Fever Tracker Application
After=network.target

[Service]
User=fevertracker_user
Group=fevertracker_user
WorkingDirectory=/opt/fevertracker
Environment=HOME=/home/fevertracker_user
Environment=USER=fevertracker_user
Environment=PATH=/home/fevertracker_user/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/fevertracker_user/.local/bin/uv run streamlit run main.py --server.port 8501 --server.headless true
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fever_tracker

[Install]
WantedBy=multi-user.target
